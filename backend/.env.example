# Copy to .env and edit. Every value below is the actual default in
# app/config.py -- a fresh clone with NO .env at all runs fine on these
# defaults (HEURISTIC engine, SQLite, simulated email). Fill in GROQ_API_KEY
# and/or SMTP_* only if you want the live LLM path or real email delivery.

# --- Database ---
# Any SQLAlchemy URL works. Leave unset for a local SQLite file.
DATABASE_URL=sqlite:///./trace.db

# --- Agent ---
# HEURISTIC = deterministic scoring engine, no API calls (what batch eval always uses)
# LLM       = every case goes straight to a real Groq call
# ROUTED    = heuristic runs first; escalates to the LLM only on 4 specific triggers
AGENT_MODE=HEURISTIC
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AGENT_MIN_CONFIDENCE=0.5

# --- ROUTED mode thresholds (only matter if AGENT_MODE=ROUTED) ---
LLM_ROUTE_MIN_CLASSIFICATION_CONFIDENCE=0.6
LLM_ROUTE_EV_MARGIN_PCT=0.05
LLM_ROUTE_HIGH_VALUE_MIN_ATTEMPTS=1
LLM_ROUTE_ON_PRIOR_EVIDENCE=true

# --- LLM call resilience ---
LLM_RATE_LIMIT_MAX_RETRIES=2
LLM_RATE_LIMIT_BACKOFF_SECONDS=0.5
LLM_RATE_LIMIT_BACKOFF_MULTIPLIER=3.0
LLM_CALL_MAX_WALL_CLOCK_SECONDS=15.0

# --- Policy ---
MAX_RECOVERY_ATTEMPTS=3
RECOVERY_WINDOW_MINUTES=4320
RECOVERY_WINDOW_MINUTES_BANK_TIMEOUT=60
MAX_SAME_ACTION_REPEATS=1
HIGH_VALUE_THRESHOLD=50000
POLICY_MIN_CONFIDENCE=0.4
MAX_REASSESSMENT_ITERATIONS=4

# --- Email (leave blank to use clearly-labeled SIMULATED sends) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=15
EMAIL_FROM=recovery@trace-demo.example
RECOVERY_LINK_BASE_URL=http://localhost:8000/pay

# --- Simulation ---
SIMULATION_SEED=42
DEFAULT_BATCH_SIZE=300

# --- Startup auto-seed ---
AUTO_SEED_ON_STARTUP=true
AUTO_SEED_SIZE=300

# --- CORS ---
# Comma-separated. Add your local dev origin alongside the deployed frontend, e.g.:
# CORS_ORIGINS=http://localhost:5173,https://trace-xi-nine.vercel.app
CORS_ORIGINS=https://trace-xi-nine.vercel.app
